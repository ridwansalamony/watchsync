# Salin menjadi .env.production di folder deploy pada VPS; jangan commit file hasilnya.
REALTIME_DOMAIN=realtime.example.com
REALTIME_IMAGE=ghcr.io/username/watchsync-realtime:latest
NODE_ENV=production
REALTIME_HOST=0.0.0.0
REALTIME_PORT=4000
REALTIME_CORS_ORIGIN=https://watchsync.example.com
REALTIME_DATABASE_URL=postgresql://user:password@host/watchsync?sslmode=require
REALTIME_JWT_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
YOUTUBE_API_KEY=
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
REDIS_NAMESPACE=wsr:production
